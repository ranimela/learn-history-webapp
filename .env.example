# LLM Provider Configuration (Vercel AI SDK)
# Supported providers: openai, google
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini

# Access Control (Single-user gate protection)
APP_PASSCODE=history123

# Database Connection (Drizzle + LibSQL / SQLite)
# For local development: file:./local.db
# For production Turso: libsql://[db-name]-[org].turso.io
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=
