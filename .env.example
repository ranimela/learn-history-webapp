# LLM Provider Configuration (Vercel AI SDK)
# Supported providers: google, openai
LLM_PROVIDER=google
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=your_gemini_api_key_here

# Access Control (Single-user gate protection)
APP_PASSCODE=history123

# Database Connection (Drizzle + LibSQL / SQLite)
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=
